--
-- Name: classtype; Type: TYPE; Schema: public; Owner: -
--

CREATE TYPE public.classtype AS ENUM (
    'Lecture',
    'Tutorial',
    'Seminar',
    'Lab Class',
    'Tute-Lab'
);


--
-- Name: populationrecord; Type: TYPE; Schema: public; Owner: -
--

CREATE TYPE public.populationrecord AS (
	tablename text,
	ntuples integer
);


--
-- Name: roomtype; Type: TYPE; Schema: public; Owner: -
--

CREATE TYPE public.roomtype AS ENUM (
    'Lecture Theatre',
    'Tutorial Room',
    'Computer Lab',
    'Meeting Room'
);


--
-- Name: weekday; Type: TYPE; Schema: public; Owner: -
--

CREATE TYPE public.weekday AS ENUM (
    'Mon',
    'Tue',
    'Wed',
    'Thu',
    'Fri'
);


--
-- Name: dbpop(); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.dbpop() RETURNS SETOF public.populationrecord
    LANGUAGE plpgsql
    AS $$
declare
	rec record;
	qry text;
	res PopulationRecord;
	num integer;
begin
	for rec in select tablename from pg_tables where schemaname='public' order by tablename
	loop
		qry := 'select count(*) from ' || quote_ident(rec.tablename);
		execute qry into num;
		res.tablename := rec.tablename; res.ntuples := num;
		return next res;
	end loop;
	return;
end;
$$;


--
-- Name: q3(text); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.q3(_roomname text) RETURNS SETOF text
    LANGUAGE plpgsql
    AS $$
declare
	_roomType text;
	_roomID integer;
	_nprobs integer := 0;
	_c record;
begin
	select id,rtype::text into _roomID,_roomType
	from Rooms where name = _roomName;
	if not found then
		return next 'No such room';
		return;
	end if;
	for _c in 
		select * from ClassInfo where rid = _roomID order by day,s,course
	loop
		if (_c.ctype = 'Lecture' and _c.rtype = 'Lecture Theatre') then
			continue;
		elsif (_c.ctype = 'Tutorial' and _c.rtype = 'Tutorial Room') then
			continue;
		elsif (_c.ctype = 'Tute-Lab' and _c.rtype = 'Tutorial Room') then
			continue;
		elsif (_c.ctype = 'Lab Class' and _c.rtype = 'Computer Lab') then
			continue;
		elsif (_c.ctype = 'Tute-Lab' and _c.rtype = 'Computer Lab') then
			continue;
		end if;
		return next _c.course||' '||_c.ctype||' '||_c.day||' '||_c.s||'-'||_c.e||' is not appropriate for '||_roomName||' ('||_c.rtype||')';
		_nprobs := _nprobs + 1;
	end loop;
	if _nprobs = 0 then
		return next 'All uses of '||_roomName||' are appropriate';
	end if;
end;
$$;


SET default_tablespace = '';

SET default_table_access_method = heap;

--
-- Name: attends; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.attends (
    student_id integer NOT NULL,
    class_id integer NOT NULL
);


--
-- Name: classes; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.classes (
    id integer NOT NULL,
    course character(8) NOT NULL,
    ctype public.classtype NOT NULL,
    held_in integer NOT NULL,
    day_of_week public.weekday NOT NULL,
    start_time integer NOT NULL,
    end_time integer NOT NULL,
    CONSTRAINT classes_course_check CHECK ((course ~ '[A-Z]{4}[0-9]{4}'::text)),
    CONSTRAINT classes_end_time_check CHECK (((end_time >= 8) AND (end_time <= 21))),
    CONSTRAINT classes_start_time_check CHECK (((start_time >= 7) AND (start_time <= 19)))
);


--
-- Name: facilities; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.facilities (
    id integer NOT NULL,
    name text NOT NULL
);


--
-- Name: has; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.has (
    room_id integer NOT NULL,
    facility_id integer NOT NULL,
    nitems integer NOT NULL,
    CONSTRAINT has_nitems_check CHECK ((nitems > 0))
);


--
-- Name: rooms; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.rooms (
    id integer NOT NULL,
    name text NOT NULL,
    rtype public.roomtype NOT NULL,
    capacity integer NOT NULL,
    CONSTRAINT rooms_capacity_check CHECK ((capacity > 0))
);


--
-- Name: students; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.students (
    id integer NOT NULL,
    name text NOT NULL,
    d_o_birth date NOT NULL
);


